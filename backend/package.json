{
  "name": "@workspace/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/main.mjs",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "tsx --test tests/domain/resource-types.test.ts tests/core/web-client.test.ts tests/core/health-check.test.ts tests/domain/workspace-validation.test.ts tests/api/middleware/request-origin.test.ts tests/api/middleware/public-origin.test.ts",
    "test:integration": "NODE_ENV=test tsx --test tests/core/pool-errors.test.ts tests/api/routes/workspace.lifecycle.test.ts tests/api/routes/enquiries.test.ts tests/api/routes/resources.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "push": "drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts",
    "codegen": "orval --config ./orval.config.ts"
  },
  "dependencies": {
    "@clerk/express": "^2.1.72",
    "@clerk/shared": "^4.36.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "orval": "^8.41.0",
    "pino-pretty": "^13.1.3",
    "thread-stream": "4.2.0",
    "tsx": "catalog:"
  }
}
