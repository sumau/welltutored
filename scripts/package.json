{
  "name": "@welltutored/scripts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "codegen:check": "tsx ./codegen-check/codegen-check.ts",
    "docs:check": "tsx ./docs-check/docs-check.ts",
    "prepare:integration-database": "tsx ./integration-database/prepare.ts",
    "test:integration-database": "tsx --test ./integration-database/check.test.ts",
    "smoke:public-site": "tsx ./smoke/public-site.ts",
    "smoke:domain": "tsx ./smoke/domain.ts",
    "smoke:enquiry": "tsx ./smoke/enquiry-browser.ts",
    "smoke:workspace": "tsx ./smoke/workspace-browser.ts",
    "test:smoke": "tsx --test ./smoke/public-site.test.ts ./smoke/domain.test.ts",
    "test:docs": "tsx --test ./docs-check/docs-check.test.ts",
    "test:codegen-check": "tsx --test ./codegen-check/check.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "tsx": "catalog:"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "playwright-core": "^1.63.0"
  }
}
